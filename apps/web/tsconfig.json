{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    // "node" only because @acemate/core's protocol also declares Buffer helpers for the Node tools; the page never calls them.
    "types": ["node", "vite/client"]
  },
  "include": ["src", "test", "vite.config.ts"]
}
